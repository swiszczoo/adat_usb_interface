[submodule "firmware/lib/cmsis-device-f4"]
	path = firmware/lib/cmsis-device-f4
	url = https://github.com/STMicroelectronics/cmsis-device-f4
[submodule "firmware/lib/cmsis-core"]
	path = firmware/lib/cmsis-core
	url = https://github.com/STMicroelectronics/cmsis-core
[submodule "firmware/lib/stm32f4xx-hal-driver"]
	path = firmware/lib/stm32f4xx-hal-driver
	url = https://github.com/STMicroelectronics/stm32f4xx-hal-driver
[submodule "firmware/lib/tinyusb"]
	path = firmware/lib/tinyusb
	url = https://github.com/hathach/tinyusb
[submodule "firmware/lib/FreeRTOS-Kernel"]
	path = firmware/lib/FreeRTOS-Kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel
